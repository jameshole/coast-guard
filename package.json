{
  "name": "coast-guard",
  "version": "1.0.0",
  "description": "A lightweight code browsing tool with syntax highlighting, git diff visualization, and markdown rendering",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "bin": {
    "coast-guard": "./bin/coast-guard.js"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspaces",
    "start": "node bin/coast-guard.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "open": "^10.0.3"
  }
}
